SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
# Use the SESSION POOLER (port 5432) — works from any network including localhost
# Transaction pooler (6543) also works but doesn't support SET/SHOW commands
SUPABASE_DB_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@[YOUR_POOLER_HOST]:5432/postgres
DB_SCHEMA=public
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_SECRET=[YOUR_SUPABASE_JWT_SECRET]
TURNSTILE_SECRET_KEY=[YOUR_TURNSTILE_SECRET_KEY]
FRONTEND_ORIGIN=https://your-app.vercel.app
# Reasoning/output budgets for system-design requests. Keep LLM_MAX_TOKENS above
# both thinking budgets so the model has room for its final answer.
THINKING_BUDGET_TOKENS=6000
PRODUCTION_THINKING_BUDGET_TOKENS=9000
GRAPH_CRITIC_THINKING_BUDGET_TOKENS=3000
LLM_MAX_TOKENS=12000
AGENT_TIMEOUT_S=360
DIAGRAM_EVALUATION_TIMEOUT_S=15
MAX_DIAGRAM_SCREENSHOT_BYTES=400000
# Optional model overrides:
# ORCHESTRATOR_MODEL=claude-opus-5
# WORKER_MODEL=claude-opus-5
# GRAPH_REPAIR_MODEL=claude-opus-5
FAISS_ARTIFACT_URL=https://your-artifact-host/faiss-bundle.tar.gz
FAISS_ARTIFACT_SHA256=[REQUIRED_SHA256_CHECKSUM_FOR_DOWNLOADS]
FAISS_ARTIFACT_MAX_DOWNLOAD_BYTES=268435456
FAISS_ARTIFACT_MAX_EXTRACTED_BYTES=536870912
FAISS_ARTIFACT_MAX_FILES=1000
# DATA_DIR=/data
INTERNAL_TEST_PASSWORD=[LONG_RANDOM_TEST_PASSWORD]
INTERNAL_TEST_EMAIL_ALLOWLIST_RAW=you@example.com
INTERNAL_TEST_SESSION_MINUTES=30
INTERNAL_DASHBOARD_ALLOWLIST_RAW=you@example.com
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-engineering-study-agent
OTEL_SERVICE_VERSION=0.1.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS_RAW=
TELEMETRY_RETENTION_DAYS=30
DASHBOARD_QUERY_MAX_ROWS=20000
# ── Supabase Management (scripts only — never used by the app at runtime) ─────
# Required by scripts/apply_supabase_config.py
SUPABASE_PROJECT_REF=[YOUR_SUPABASE_PROJECT_REF]
# Personal access token from supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=[YOUR_SUPABASE_MANAGEMENT_TOKEN]
APP_SITE_URL=https://your-app.vercel.app
# Optional, comma-separated. Leave blank to default to localhost + APP_SITE_URL/**
APP_REDIRECT_URLS=http://localhost:5173/**,https://your-app.vercel.app/**

# Required by scripts/populate_secrets.sh
GCP_PROJECT_ID=[YOUR_GCP_PROJECT_ID]
# One-time infrastructure inputs. The staging URL must authenticate as the
# dedicated agent_staging role; the migration URL is never mounted into Cloud Run.
STAGING_SUPABASE_DB_URL=postgresql://agent_staging:[PASSWORD]@[YOUR_POOLER_HOST]:5432/postgres
PRODUCTION_MIGRATION_DB_URL=postgresql://agent_production_migrator:[PASSWORD]@[YOUR_POOLER_HOST]:5432/postgres
SUPABASE_ADMIN_DB_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[ADMIN_PASSWORD]@[YOUR_POOLER_HOST]:5432/postgres
STAGING_DB_PASSWORD=[LONG_RANDOM_STAGING_ROLE_PASSWORD]
